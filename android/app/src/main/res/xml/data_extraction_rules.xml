<?xml version="1.0" encoding="utf-8"?>
<!-- Progress and settings may be backed up; the session token and cached audio stay on this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nedfa.session.xml" />
        <exclude domain="file" path="audio" />
        <exclude domain="file" path="content" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nedfa.session.xml" />
        <exclude domain="file" path="audio" />
    </device-transfer>
</data-extraction-rules>
