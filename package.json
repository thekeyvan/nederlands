{
  "name": "nedfa",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/site-images.mjs && react-router dev",
    "build": "node scripts/site-images.mjs && npm run typecheck && react-router build && node scripts/build-sw.mjs",
    "start": "NODE_ENV=production node server.mjs",
    "typecheck": "react-router typegen && tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "test": "node --test tests/*.test.js",
    "locale:new": "node scripts/new-locale.mjs",
    "build:native": "node scripts/native/export-content.mjs && cd ios-native && xcodegen generate"
  },
